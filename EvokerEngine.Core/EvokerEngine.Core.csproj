<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Enable multi-targeting for mobile when workloads are available -->
    <TargetFrameworks Condition="'$(BuildForMobile)' == 'true'">net9.0;net9.0-android;net9.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Mobile-specific settings (only apply when building for mobile) -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>EvokerEngine.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Evoker Industries</Authors>
    <Company>Evoker Industries</Company>
    <Description>A complete C# game engine with Vulkan rendering support using Silk.NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Evoker-Industries/Evoker-Engine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Evoker-Industries/Evoker-Engine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>game-engine;vulkan;silk-net;gamedev;ecs;rendering</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="StbImageSharp" Version="2.27.14" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
